# === Telegram Bot & Storage ===
# Token gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=
# Seu ID numérico de usuário no Telegram (ex: obtido com @userinfobot)
TELEGRAM_USER_ID=
# ID do Canal Privado de armazenamento (ex: -1001234567890)
STORAGE_CHANNEL_ID=

# === Criptografia do Snapshot ===
# Chave secreta (gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
STORAGE_ENCRYPTION_KEY=

# === Banco de Dados & Servidor Web ===
# Local: sqlite+aiosqlite:///./data/assistant.db
# Neon Postgres (Vercel): postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./data/assistant.db
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Token opcional para proteger acesso remoto ao Dashboard PWA
WEB_ACCESS_TOKEN=
# URL pública da Vercel (ex: https://meu-assistente.vercel.app) e secret do Webhook
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=

# === Sincronização com Canal ===
SYNC_DEBOUNCE_SECONDS=60
SYNC_ENABLED=true

# === IA Local Opcional (Fase 5) ===
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
WHISPER_MODEL=small

